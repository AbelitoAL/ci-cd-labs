{
  "name": "ci-cd-labs",
  "version": "1.0.0",
  "description": "Proyecto de ejemplo para los laboratorios de CI/CD (build + pruebas unitarias + cobertura).",
  "main": "src/index.js",
  "scripts": {
    "build": "esbuild src/index.js --bundle --platform=node --outfile=dist/bundle.js",
    "test": "jest --coverage",
    "start": "node dist/bundle.js"
  },
  "devDependencies": {
    "esbuild": "^0.24.0",
    "jest": "^29.7.0",
    "jest-junit": "^16.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "collectCoverage": true,
    "coverageDirectory": "coverage",
    "collectCoverageFrom": [
      "src/**/*.js"
    ],
    "coverageReporters": [
      "text",
      "lcov",
      "html"
    ],
    "reporters": [
      "default",
      [
        "jest-junit",
        {
          "outputDirectory": "reports",
          "outputName": "junit.xml"
        }
      ]
    ]
  }
}
